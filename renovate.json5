{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>bennettoxford/renovate-config:default.json5",
    "github>bennettoxford/renovate-config:uv-minimumreleaseage-workaround.json5",
  ],
  "packageRules": [
    // Temporarily pin pytest as it's broken xdist:
    // https://github.com/pytest-dev/pytest/issues/15303
    // xdist has a fix which has been merged but not released yet
    {
      "matchManagers": ["pep621"],
      "matchDepNames": ["pytest"],
      "allowedVersions": "<9.2.0"
    },
    // Allow unstable prerelease updates for these two packages, which use the
    // PEP440 beta marker and don't get version updates otherwise
    {
      "matchManagers": ["pep621"],
      "matchPackageNames": [
        "opentelemetry-instrumentation-django",
        "opentelemetry-instrumentation-requests"
      ],
      "ignoreUnstable": false,
      "rangeStrategy": "widen"
    },
  ]
}
